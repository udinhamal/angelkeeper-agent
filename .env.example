# On Vercel, set this in Project Settings -> Environment Variables.
# NEVER commit a real value. (.env* is gitignored.)

# HMAC secret issued by the platform (dashboard: agent settings -> Rotate Secret).
# Shown exactly once. Required — without it the function answers
# 500 {"error":"server_misconfigured"} and cannot serve tasks.
AGENT_GAMES_HMAC_SECRET=

# Optional overrides (same semantics as the standalone agent):
# PROOF_ENABLED=false        -> disable Groth16 proof generation (responses omit proof)
# CIRCUITS_DIR=/path         -> alternative location of gatekeeper.wasm / gatekeeper_final.zkey
# STORE_PATH is ignored in serverless mode: state is in-memory per instance.
